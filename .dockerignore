# Allow only runtime inputs and the frontend sources needed by the build.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!uv.lock
!README.md
!API/
!API/**
!income/
!income/*.py
!income/models/
!income/models/**
!eda/
!eda/EDA.py
!openbanking_mock/
!openbanking_mock/obmock/
!openbanking_mock/obmock/**
!openbanking_mock/specs/
!openbanking_mock/specs/**
!openbanking_mock/fixtures/
!openbanking_mock/fixtures/**
!openbanking_mock/output/
!openbanking_mock/output/dataset/
!openbanking_mock/output/dataset/MANIFEST.json
!openbanking_mock/output/dataset/truth/
!openbanking_mock/output/dataset/truth/customers/
!openbanking_mock/output/dataset/truth/customers/**
!nbg_synthetic_data/
!nbg_synthetic_data/**
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/vite.config.js
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!tools/
!tools/start_production.py
!tests/
!tests/**

# Never include local state, caches or credentials even inside allowed trees.
**/__pycache__/
**/*.py[cod]
**/node_modules/
**/.venv/
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.sqlite*
**/*.log
